<apex:page controller="FleetforceMotorpoolController" showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>FleetForce Motorpool Portal</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
body {
    margin: 0; padding: 20px;
    background: #f3f3f3;
    font-family: 'Salesforce Sans', Arial, sans-serif;
    font-size: 14px; color: #3e3e3c;
}
.portal-container {
    max-width: 650px; margin: 40px auto;
    background: #fff; border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
    overflow: hidden; border: 1px solid #e5e5e5;
}
.portal-header { background: #0176D3; color: #fff; padding: 24px; text-align: center; }
.portal-header h1 { margin: 0; font-size: 24px; font-weight: 300; }
.form-body { padding: 30px; }
.step { display: none; }
.step.active { display: block; }
.step-indicator { display: flex; gap: 8px; margin-bottom: 24px; align-items: center; justify-content: center; }
.step-dot { width: 10px; height: 10px; border-radius: 50%; background: #d8dde6; transition: background .2s; }
.step-dot.active { background: #0176D3; }
.step-dot.done   { background: #2e844a; }
h2 { margin: 0 0 20px; font-size: 18px; font-weight: 600; color: #181818; }
label { display: block; font-weight: 600; margin-bottom: 4px; }
.field { margin-bottom: 16px; }
input[type="text"], input[type="email"], input[type="tel"], input[type="datetime-local"], input[type="number"] {
    width: 100%; padding: 10px 12px; border: 1px solid #c9c9c9; border-radius: 4px; font-size: 14px;
}
input:focus { outline: none; border-color: #0176D3; box-shadow: 0 0 0 3px rgba(1,118,211,.15); }
input.error { border-color: #c23934; }
.err-msg { color: #c23934; font-size: 12px; margin-top: 4px; display: none; }
.err-msg.show { display: block; }
.row { display: flex; gap: 16px; }
.row .field { flex: 1; }
.btn-row { display: flex; gap: 12px; margin-top: 24px; justify-content: flex-end; }
button { padding: 10px 24px; border-radius: 4px; font-size: 14px; font-weight: 600; cursor: pointer; }
.btn-primary { background: #0176D3; color: #fff; border: none; }
.btn-primary:hover { background: #0E4DBD; }
.btn-primary:disabled { opacity: .5; cursor: not-allowed; }
.btn-secondary { background: #fff; color: #0176D3; border: 1px solid #0176D3; }
.success-box { text-align: center; padding: 16px 0; }
.success-box .check { font-size: 48px; margin-bottom: 12px; }
.success-box h2 { color: #2e844a; }
.success-box p { color: #444; line-height: 1.6; }
.global-error { background: #fde8e8; border: 1px solid #c23934; border-radius: 4px; padding: 12px; margin-bottom: 16px; color: #c23934; display: none; }
.global-error.show { display: block; }
</style>
</head>
<body>
<div class="portal-container">
    <div class="portal-header"><h1>FleetForce Motorpool Portal</h1></div>
    <div class="form-body">
        <div class="step-indicator">
            <div class="step-dot active" id="dot1"></div>
            <div class="step-dot" id="dot2"></div>
        </div>
        <div class="global-error" id="globalErr"></div>

        <div class="step active" id="step1">
            <h2>Step 1: Your Information</h2>
            <p style="margin:0 0 20px;color:#555">Please provide your contact information to begin.</p>
            <div class="row">
                <div class="field">
                    <label for="firstName">First Name *</label>
                    <input type="text" id="firstName" placeholder="Jane"/>
                    <div class="err-msg" id="err-firstName">First name is required.</div>
                </div>
                <div class="field">
                    <label for="lastName">Last Name *</label>
                    <input type="text" id="lastName" placeholder="Smith"/>
                    <div class="err-msg" id="err-lastName">Last name is required.</div>
                </div>
            </div>
            <div class="field">
                <label for="email">Email Address *</label>
                <input type="email" id="email" placeholder="jane.smith@example.com"/>
                <div class="err-msg" id="err-email">A valid email address is required.</div>
            </div>
            <div class="field">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" placeholder="(555) 123-4567"/>
            </div>
            <div class="btn-row"><button class="btn-primary" onclick="goStep2()">Next</button></div>
        </div>

        <div class="step" id="step2">
            <h2>Step 2: Trip Details</h2>
            <p style="margin:0 0 20px;color:#555;font-weight:600">Vehicle Needs</p>
            <div class="row">
                <div class="field">
                    <label for="startTime">Pickup Date &amp; Time *</label>
                    <input type="datetime-local" id="startTime"/>
                    <div class="err-msg" id="err-startTime">Pickup date is required.</div>
                </div>
                <div class="field">
                    <label for="endTime">Return Date &amp; Time *</label>
                    <input type="datetime-local" id="endTime"/>
                    <div class="err-msg" id="err-endTime">Return date is required.</div>
                </div>
            </div>
            <div class="field">
                <label for="minSeats">Minimum Number of Seats Needed *</label>
                <input type="number" id="minSeats" min="1" max="99" placeholder="2"/>
                <div class="err-msg" id="err-minSeats">Please enter the number of seats needed.</div>
            </div>
            <div class="btn-row">
                <button class="btn-secondary" onclick="goStep1()">Back</button>
                <button class="btn-primary" id="submitBtn" onclick="submitForm()">Submit Request</button>
            </div>
        </div>

        <div class="step" id="stepSuccess">
            <div class="success-box">
                <div class="check">&#x2705;</div>
                <h2>Request Submitted!</h2>
                <p>Your reservation request has been submitted to the fleet operations team. You will receive an email once it is approved and a vehicle is assigned.</p>
                <button class="btn-primary" style="margin-top:8px" onclick="resetForm()">Submit Another Request</button>
            </div>
        </div>
    </div>
</div>

<script>
function show(id) {
    ['step1','step2','stepSuccess'].forEach(function(s){document.getElementById(s).classList.remove('active');});
    document.getElementById(id).classList.add('active');
}
function setDots(active, done) {
    document.getElementById('dot1').className='step-dot'+(done>=1?' done':(active===1?' active':''));
    document.getElementById('dot2').className='step-dot'+(done>=2?' done':(active===2?' active':''));
}
function clearErr(id){var f=document.getElementById(id),e=document.getElementById('err-'+id);if(f)f.classList.remove('error');if(e)e.classList.remove('show');}
function showErr(id,msg){var f=document.getElementById(id),e=document.getElementById('err-'+id);if(f)f.classList.add('error');if(e){if(msg)e.textContent=msg;e.classList.add('show');}return false;}
function val(id){return(document.getElementById(id).value||'').trim();}
function goStep2(){
    var ok=true;
    ['firstName','lastName','email'].forEach(function(id){clearErr(id);});
    if(!val('firstName'))ok=showErr('firstName');
    if(!val('lastName'))ok=showErr('lastName');
    var em=val('email');
    if(!em||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em))ok=showErr('email');
    if(!ok)return;
    show('step2');setDots(2,1);
}
function goStep1(){show('step1');setDots(1,0);}
function isoToApex(s){if(!s)return'';return s.length===16?s+':00.000Z':s+'.000Z';}
function submitForm(){
    var ok=true;
    ['startTime','endTime','minSeats'].forEach(function(id){clearErr(id);});
    if(!val('startTime'))ok=showErr('startTime');
    if(!val('endTime'))ok=showErr('endTime');
    var seats=parseInt(val('minSeats'),10);
    if(!val('minSeats')||isNaN(seats)||seats<1)ok=showErr('minSeats');
    if(!ok)return;
    if(val('endTime')<=val('startTime')){showErr('endTime','Return date must be after pickup date.');return;}
    var btn=document.getElementById('submitBtn');
    btn.disabled=true;btn.textContent='Submitting…';
    document.getElementById('globalErr').classList.remove('show');
    var xhr=new XMLHttpRequest();
    xhr.open('POST','/services/apexrest/fleetforce/motorpoolReservation',false);
    xhr.setRequestHeader('Content-Type','application/json');
    // Fall back to custom REST endpoint. If unavailable, show config error.
    try {
        submitViaRemoting(btn,seats);
    } catch(e) {
        btn.disabled=false;btn.textContent='Submit Request';
        var err=document.getElementById('globalErr');
        err.textContent='Service unavailable. Please try again later.';
        err.classList.add('show');
    }
}
function submitViaRemoting(btn,seats){
    if(typeof Visualforce === 'undefined' || !Visualforce.remoting){
        btn.disabled=false;btn.textContent='Submit Request';
        var err=document.getElementById('globalErr');
        err.textContent='The form service is not available. Please contact the site administrator.';
        err.classList.add('show');
        return;
    }
    Visualforce.remoting.Manager.invokeAction(
        'fleetforce.FleetforceMotorpoolController.submitReservation',
        val('firstName'),val('lastName'),val('email'),val('phone'),
        isoToApex(val('startTime')),isoToApex(val('endTime')),seats,
        function(result,event){
            btn.disabled=false;btn.textContent='Submit Request';
            if(event.status&&result){show('stepSuccess');document.querySelector('.step-indicator').style.display='none';}
            else{var e=document.getElementById('globalErr');e.textContent=(event.message||'An error occurred. Please try again.');e.classList.add('show');}
        },{escape:false}
    );
}
function resetForm(){
    ['firstName','lastName','email','phone','startTime','endTime','minSeats'].forEach(function(id){document.getElementById(id).value='';clearErr(id);});
    document.querySelector('.step-indicator').style.display='';show('step1');setDots(1,0);
}
</script>
</body>
</html>
</apex:page>
