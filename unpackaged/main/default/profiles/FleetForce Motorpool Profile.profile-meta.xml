<?xml version="1.0" encoding="UTF-8"?>
<!-- Guest user profile of the FleetForce Motorpool Experience site. Deliberately minimal: only lets the public
     booking page call its Apex. Profiles are not packageable, so this lives in unpackaged/. -->
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>MotorpoolBookingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FleetDisplaySettingsController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <custom>false</custom>
    <userLicense>Guest User License</userLicense>
</Profile>
