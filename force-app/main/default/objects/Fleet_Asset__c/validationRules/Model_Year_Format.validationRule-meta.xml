<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Model_Year_Format</fullName>
    <active>true</active>
    <description
  >A model year is blank or four digits from 1900 to 2099.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Model_Year__c)), NOT(REGEX(Model_Year__c, "(19|20)[0-9]{2}")))</errorConditionFormula>
    <errorDisplayField>Model_Year__c</errorDisplayField>
    <errorMessage
  >Enter the model year as four digits, for example 2023.</errorMessage>
</ValidationRule>
