/**
 * @description Dynamic, metadata-driven auto-naming engine for FleetForce records.
 * Evaluates tokenized naming patterns (e.g. {Model_Year__c} {Make__c} {Model__c} · {License_Plate__c}),
 * sanitizes separators, enforces Salesforce 80-character Name limit, and provides hardcoded
 * defaults to guarantee records are always cleanly and meaningfully named even if configuration is absent.
 */
public with sharing class AutoNamingService {
  public static Boolean isBypassed = false;
  private static final Integer MAX_NAME_LENGTH = 80;
  private static final Pattern TOKEN_PATTERN = Pattern.compile(
    '\\{([a-zA-Z0-9_]+)\\}'
  );

  // Built-in hardcoded fallback patterns if Custom Metadata is missing or unconfigured
  private static final Map<String, String> BUILTIN_DEFAULT_PATTERNS = new Map<String, String>{
    'Fleet_Asset__c' => '{Model_Year__c} {Make__c} {Model__c} · {License_Plate__c}',
    'Citation__c' => '{Ticket_Number__c} · {Violation_Type__c}',
    'Reservation__c' => '{Preferred_Body__c} ({Status__c})',
    'Driver_Qualification__c' => '{Type__c} ({Status__c})'
  };

  /**
   * @description Applies auto-naming to records in before-insert or before-update trigger context.
   * @param records List of records being inserted or updated.
   */
  public static void apply(List<SObject> records) {
    if (isBypassed || records == null || records.isEmpty()) {
      return;
    }

    SObjectType sType = records[0].getSObjectType();
    Map<String, SObjectField> fieldMap = sType.getDescribe().fields.getMap();
    SObjectField nameField = fieldMap.get('name');
    if (
      nameField == null ||
      !nameField.getDescribe().isCreateable() ||
      !nameField.getDescribe().isUpdateable()
    ) {
      return;
    }

    String fullObjectName = sType.getDescribe().getName();
    String cleanObjectName = stripNamespace(fullObjectName);

    Auto_Naming_Rule__mdt rule = getRule(cleanObjectName);
    Boolean allowOverride = (rule != null &&
    rule.Allow_Manual_Override__c == true);
    String pattern = resolvePattern(rule, cleanObjectName);

    for (SObject record : records) {
      String currentName = (String) record.get('Name');
      // If manual override is allowed and a meaningful custom name was explicitly provided, preserve it
      if (
        allowOverride &&
        String.isNotBlank(currentName) &&
        !isAutoGeneratedPlaceholder(currentName)
      ) {
        continue;
      }

      String generatedName = formatName(
        record,
        pattern,
        fieldMap,
        cleanObjectName
      );
      if (String.isNotBlank(generatedName)) {
        record.put('Name', generatedName);
      }
    }
  }

  /**
   * @description Formats a single record's name using a tokenized pattern and applies fallback cascades.
   */
  public static String formatName(
    SObject record,
    String pattern,
    Map<String, SObjectField> fieldMap,
    String cleanObjectName
  ) {
    if (record == null) {
      return null;
    }

    if (fieldMap == null) {
      fieldMap = record.getSObjectType().getDescribe().fields.getMap();
    }
    if (String.isBlank(cleanObjectName)) {
      cleanObjectName = stripNamespace(
        record.getSObjectType().getDescribe().getName()
      );
    }

    String rawResult = pattern;
    if (String.isNotBlank(pattern)) {
      Matcher m = TOKEN_PATTERN.matcher(pattern);
      Set<String> tokens = new Set<String>();
      while (m.find()) {
        tokens.add(m.group(1));
      }
      for (String tokenField : tokens) {
        String val = getFieldValueString(record, tokenField, fieldMap);
        rawResult = rawResult.replace(
          '{' + tokenField + '}',
          val != null ? val : ''
        );
      }
    }

    // Clean up empty parentheses, brackets, double spaces, and dangling separators
    String sanitized = sanitizeFormattedString(rawResult);

    // If the pattern produced an empty result (e.g. all token fields were null), fall back to defaults
    if (String.isBlank(sanitized)) {
      sanitized = applyFallbackCascade(record, fieldMap, cleanObjectName);
    }

    return enforceLength(sanitized);
  }

  /**
   * @description Resolves effective pattern from metadata rule or built-in defaults.
   */
  public static String resolvePattern(
    Auto_Naming_Rule__mdt rule,
    String cleanObjectName
  ) {
    if (
      rule != null &&
      rule.Is_Active__c &&
      String.isNotBlank(rule.Pattern__c)
    ) {
      return rule.Pattern__c;
    }
    if (BUILTIN_DEFAULT_PATTERNS.containsKey(cleanObjectName)) {
      return BUILTIN_DEFAULT_PATTERNS.get(cleanObjectName);
    }
    return '{Name}';
  }

  /**
   * @description Queries or returns cached Auto_Naming_Rule__mdt for an object.
   */
  public static Auto_Naming_Rule__mdt getRule(String cleanObjectName) {
    List<Auto_Naming_Rule__mdt> rules = [
      SELECT
        Id,
        DeveloperName,
        MasterLabel,
        Object_API_Name__c,
        Pattern__c,
        Is_Active__c,
        Allow_Manual_Override__c,
        Description__c
      FROM Auto_Naming_Rule__mdt
      WHERE Is_Active__c = TRUE
      WITH USER_MODE
    ];

    for (Auto_Naming_Rule__mdt r : rules) {
      if (
        stripNamespace(r.Object_API_Name__c).equalsIgnoreCase(cleanObjectName)
      ) {
        return r;
      }
    }
    return null;
  }

  /**
   * @description Extracts a field's string value, resolving namespace differences dynamically.
   */
  private static String getFieldValueString(
    SObject record,
    String fieldName,
    Map<String, SObjectField> fieldMap
  ) {
    String resolvedField = resolveFieldApiName(fieldName, fieldMap);
    if (resolvedField == null) {
      return '';
    }

    try {
      Object val = record.get(resolvedField);
      if (val == null) {
        return '';
      }
      if (val instanceof Date) {
        return ((Date) val).format();
      }
      if (val instanceof Datetime) {
        return ((Datetime) val).format('yyyy-MM-dd');
      }
      return String.valueOf(val).trim();
    } catch (Exception ex) {
      return '';
    }
  }

  /**
   * @description Resolves field name matching against the object's describe map (with or without namespace).
   */
  public static String resolveFieldApiName(
    String fieldName,
    Map<String, SObjectField> fieldMap
  ) {
    String clean = stripNamespace(fieldName).toLowerCase();
    for (String actual : fieldMap.keySet()) {
      if (stripNamespace(actual).toLowerCase() == clean) {
        return actual;
      }
    }
    return null;
  }

  /**
   * @description Removes empty wrappers, double spaces, and dangling boundary punctuation.
   */
  public static String sanitizeFormattedString(String input) {
    if (String.isBlank(input)) {
      return '';
    }

    String cleaned = input;
    // Strip empty parentheses () and brackets []
    cleaned = cleaned.replaceAll('\\(\\s*\\)', ' ');
    cleaned = cleaned.replaceAll('\\[\\s*\\]', ' ');
    cleaned = cleaned.replaceAll('\\{\\s*\\}', ' ');

    // Collapse multiple whitespace into a single space
    cleaned = cleaned.replaceAll('\\s+', ' ').trim();

    // Strip leading/trailing separators (·, -, /, |, ,, :)
    cleaned = cleaned.replaceAll('^[·\\-\\/|,:\\s]+', '');
    cleaned = cleaned.replaceAll('[·\\-\\/|,:\\s]+$', '');

    // Check for orphaned interior separators like "2024 Ford Transit · " or " · Transit"
    cleaned = cleaned.replaceAll('\\s*[·\\-\\/|,]\\s*$', '');
    cleaned = cleaned.replaceAll('^\\s*[·\\-\\/|,]\\s*', '');
    cleaned = cleaned.replaceAll('\\s+', ' ').trim();

    return cleaned;
  }

  /**
   * @description Guaranteed fallback cascade in case all pattern fields evaluate to null.
   */
  private static String applyFallbackCascade(
    SObject record,
    Map<String, SObjectField> fieldMap,
    String cleanObjectName
  ) {
    String currentName = (String) record.get('Name');
    if (cleanObjectName == 'Fleet_Asset__c') {
      String assetId = getFieldValueString(record, 'Asset_ID__c', fieldMap);
      if (String.isNotBlank(assetId)) {
        return assetId;
      }
      String vin = getFieldValueString(record, 'VIN__c', fieldMap);
      if (String.isNotBlank(vin)) {
        return 'VIN ' + vin;
      }
      if (String.isNotBlank(currentName)) {
        return currentName;
      }
      return 'Fleet Asset';
    } else if (cleanObjectName == 'Service_Ticket__c') {
      String summary = getFieldValueString(record, 'Summary__c', fieldMap);
      if (String.isNotBlank(summary)) {
        return summary;
      }
      return 'Maintenance Ticket';
    } else if (cleanObjectName == 'Citation__c') {
      String ticketNum = getFieldValueString(
        record,
        'Ticket_Number__c',
        fieldMap
      );
      if (String.isNotBlank(ticketNum)) {
        return 'Citation #' + ticketNum;
      }
      return 'Citation';
    } else if (cleanObjectName == 'Reservation__c') {
      return 'Fleet Reservation';
    } else if (cleanObjectName == 'Driver_Qualification__c') {
      String qualType = getFieldValueString(record, 'Type__c', fieldMap);
      if (String.isNotBlank(qualType)) {
        return qualType;
      }
      return 'Driver Qualification';
    }

    // Generic fallback
    String fallback = (String) record.get('Name');
    return String.isNotBlank(fallback)
      ? fallback
      : cleanObjectName.replace('__c', '').replace('_', ' ');
  }

  /**
   * @description Enforces the Salesforce 80-character standard Name limit.
   */
  public static String enforceLength(String name) {
    if (String.isBlank(name)) {
      return '';
    }
    String trimmed = name.trim();
    if (trimmed.length() <= MAX_NAME_LENGTH) {
      return trimmed;
    }
    return trimmed.left(MAX_NAME_LENGTH).trim();
  }

  /**
   * @description Strips package namespace prefix if present.
   */
  public static String stripNamespace(String apiName) {
    if (String.isBlank(apiName)) {
      return '';
    }
    if (
      apiName.contains('__') &&
      apiName.indexOf('__') != apiName.lastIndexOf('__')
    ) {
      return apiName.substring(apiName.indexOf('__') + 2);
    }
    return apiName;
  }

  /**
   * @description Checks if a name appears to be an unconfigured auto-generated placeholder or ID.
   */
  private static Boolean isAutoGeneratedPlaceholder(String name) {
    if (String.isBlank(name)) {
      return true;
    }
    // Match standard 15/18 char Salesforce record IDs or raw object prefixes
    return Pattern.matches('^(a0[a-zA-Z0-9]{13,16}|FA-[0-9]{4,})$', name);
  }
}
