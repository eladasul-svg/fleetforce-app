<?xml version="1.0" encoding="UTF-8" ?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description
  >Subscriber key for the FleetForce Routing Service (Cloud Run). An admin sets the ApiKey parameter on the Org principal; the service maps each key to one subscriber org.</description>
    <externalCredentialParameters>
        <parameterName>Org</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>X-FleetForce-Key</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue
    >{!$Credential.FleetForce_Routing.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>FleetForce Routing</label>
</ExternalCredential>
